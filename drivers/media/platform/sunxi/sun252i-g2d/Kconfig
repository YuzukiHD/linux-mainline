config VIDEO_SUN252I_G2D
	tristate "Allwinner F101 G2D scaler and rotation driver"
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	depends on ARCH_SUNXI || COMPILE_TEST
	depends on COMMON_CLK && RESET_CONTROLLER && OF
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	help
	   Support for the 2D graphics engine of the Allwinner F101 as a
	   memory to memory device: it converts YUV and RGB pictures to
	   RGB, scales them and rotates or flips them.
	   To compile this driver as a module choose m here.
