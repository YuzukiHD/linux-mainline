/dts-v1/;

#include <dt-bindings/pwm/pwm.h>

#include "sun252i-f101.dtsi"

/ {
	model = "Yuzukineko sun252i F101 board";
	compatible = "allwinner,sun252i-f101-yuzukineko", "allwinner,sun252i-f101";

	reg_vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	chosen {
		bootargs = "console=tty0 console=ttyS1,115200n8 earlycon=uart8250,mmio32,0x02500400 loglevel=8 printk.time=1 root=/dev/mtdblock4 rootfstype=squashfs ro";
		stdout-path = "serial1:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x02000000>;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pb_pins>;
	status = "okay";
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pb2_pins>;
	status = "okay";
};

&sdc0 {
	vmmc-supply = <&reg_vcc_3v3>;
	vqmmc-supply = <&reg_vcc_3v3>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
	status = "okay";
};

&ve {
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pc_pins>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <100000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;

		#include "sun252i-f101-nor-partitions.dtsi"
	};
};

/* The 1024x768 MIPI DSI panel of the carrier board */
&pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pd22_pin>;
	status = "okay";
};

&de {
	status = "okay";
};

&mixer0 {
	status = "okay";
};

&tcon_top {
	status = "okay";
};

&tcon_lcd0 {
	status = "okay";
};

&dphy0 {
	status = "okay";
};

&dsi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&dsi_pd_pins>;
	status = "okay";

	panel@0 {
		compatible = "jadard,jd9168s";
		reg = <0>;
		reset-gpios = <&pio 3 9 GPIO_ACTIVE_LOW>; /* PD9 */
		backlight = <&backlight>;
	};
};

/ {
	backlight: backlight {
		compatible = "pwm-backlight";
		/* PWM0 channel 2 on PD22, low is on */
		pwms = <&pwm0 2 1000000 PWM_POLARITY_INVERTED>;
		brightness-levels = <0 4 8 16 32 64 96 128 160 192 224 255>;
		default-brightness-level = <6>;
	};
};
